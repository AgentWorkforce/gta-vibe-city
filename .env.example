# Read-only observer token (ot_live_…) — the only relay credential the site
# and bridge need (REST reads + durable event-log tail). Mint one:
#   RELAY_WORKSPACE_KEY=rk_live_… node scripts/create-observer-token.mjs
RELAY_OBSERVER_TOKEN=

# Workspace admin key (rk_live_…). Only needed to mint observer tokens;
# legacy fallback when RELAY_OBSERVER_TOKEN is unset.
RELAY_WORKSPACE_KEY=

# Optional: self-hosted relay URL
# RELAY_BASE_URL=

# Optional: bridge service (bridge/server.mjs) fronting the relay
# BRIDGE_URL=http://localhost:8390
# BRIDGE_TOKEN=

# Funding + spend sources
POSTHOG_API_KEY=
STRIPE_SECRET_KEY=
# STRIPE_PAYMENT_LINK_ID=
# FUNDING_RAISED_USD=
